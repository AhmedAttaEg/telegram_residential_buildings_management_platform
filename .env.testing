APP_NAME=Laravel
APP_ENV=testing
APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=Africa/Cairo

APP_MAINTENANCE_DRIVER=file
SANCTUM_TOKEN_EXPIRATION=43200

BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=telegram_residential_buildings_testing
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
QUEUE_WORKER_CONNECTION=database
QUEUE_WORKER_MAX_TIME=55
QUEUE_WORKER_SLEEP=3
QUEUE_WORKER_TRIES=1
DB_QUEUE_CONNECTION=
DB_QUEUE_TABLE=jobs
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=90
QUEUE_FAILED_DRIVER=database-uuids

CACHE_STORE=array
DB_CACHE_CONNECTION=
DB_CACHE_TABLE=cache
DB_CACHE_LOCK_CONNECTION=
DB_CACHE_LOCK_TABLE=cache_locks
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=array
MAIL_LOG_CHANNEL=mail
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_EHLO_DOMAIN=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
TELEGRAM_BOT_TOKEN=
TELEGRAM_NOTIFICATION_CHAT_ID=
TELEGRAM_NOTIFICATION_LOG_CHANNEL=telegram
SUBSCRIPTION_REMINDER_EXPIRATION_LEAD_DAYS=7
SUBSCRIPTION_REMINDER_GRACE_ENABLED=true
SUBSCRIPTION_REMINDER_SUSPENSION_ENABLED=true

TENANT_DEFAULT_LOCALE=ar
TENANT_FALLBACK_LOCALE=en
TENANT_DEFAULT_TIMEZONE=Africa/Cairo
TENANT_DEFAULT_CURRENCY=EGP
TENANT_FEATURE_ENTERPRISE_ACCOUNTING=false
TENANT_FEATURE_MAINTENANCE=true
TENANT_FEATURE_ONLINE_PAYMENTS=false
TENANT_FEATURE_RESIDENT_APP=true
TENANT_FEATURE_AI_FEATURES=false

PULSE_ENABLED=false
TELESCOPE_ENABLED=false
NIGHTWATCH_ENABLED=false

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

BACKUP_ROOT=storage/framework/testing/backups
BACKUP_DB_DUMP_BINARY=mysqldump
BACKUP_DB_RESTORE_BINARY=mysql
BACKUP_STORAGE_INCLUDE=app,framework,logs
BACKUP_STORAGE_EXCLUDE=app/backups,framework/cache,framework/sessions,framework/testing,framework/views
BACKUP_DAILY_RETENTION_DAYS=7
BACKUP_WEEKLY_RETENTION_WEEKS=4
BACKUP_RUN_AT=02:00
BACKUP_CLEANUP_AT=02:30

VITE_APP_NAME="${APP_NAME}"
